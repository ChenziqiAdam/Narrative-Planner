\begin{frame}{Planner 决策机制（核心创新）}
    \small
    \textbf{统一 LLM 调用} — Planner + Interviewer 合并为\textbf{一次}调用，内嵌 6 步推理链：
    \begin{enumerate}\small
        \item \textbf{语义理解}当前回复
        \item \textbf{访谈阶段}判断（概述 / 深入 / 拓展 / 反思 / 收尾）
        \item \textbf{事件完整度}评估（时间/地点/人物/原因/结果/感受/反思/顺序）
        \item \textbf{情绪与精力}感知（energy + valence）
        \item \textbf{图谱与主题缺口}分析
        \item \textbf{候选动作打分} $\to$ 选最优
    \end{enumerate}
    \begin{block}{9 种规划器动作}
        \scriptsize
        \texttt{continue\_overview} · \texttt{deep\_dive} · \texttt{clarify} · \texttt{confirm\_summary} · \texttt{switch\_theme}
        · \texttt{move\_to\_person} · \texttt{move\_to\_period} · \texttt{reflection} · \texttt{end}
    \end{block}
    输出结构化 \texttt{planner\_plan} JSON（stage, action, focus, completeness, emotion, candidates, tone）— \textbf{可观测、可调试、可实验}
\end{frame}

\begin{frame}{检索策略：Schema-on-the-fly + RRF 三路融合}
    \begin{columns}[T]
        \begin{column}{0.57\textwidth}
            \small
            \textbf{Schema-on-the-fly 提取：}
            \begin{itemize}\setlength{\itemsep}{1pt}
                \item 不预设固定槽位，LLM 自由提取实体和关系
                \item 5 种实体类型：Event / Person / Location / Emotion / Insight
                \item 实体 ID
                \item LLM 自主决定：new / update / skip
            \end{itemize}
            \vspace{0.15em}
            \textbf{实体去重双重校验：}
            \begin{itemize}\setlength{\itemsep}{1pt}
                \item 向量余弦相似度 $> 0.85$
                \item 名称子串匹配
            \end{itemize}
            \vspace{0.15em}
            事件在写入时自动关联 McAdams \textbf{23 个人生主题}。
        \end{column}
        \begin{column}{0.41\textwidth}
            \small
            \textbf{三路检索互补：}
            \begin{itemize}\setlength{\itemsep}{1pt}
                \item \textbf{向量}$\alpha\!=\!0.5$：语义近似
                \item \textbf{图遍历}$\beta\!=\!0.3$：关系发现
                \item \textbf{全文}$\gamma\!=\!0.2$：关键词命中
            \end{itemize}
            \vspace{0.15em}
            % 这里修复：无空行 + 删除多余的\end{block}
            \begin{block}{RRF 融合公式}
            \[
            s(e) = \frac{\alpha}{K+r_v} + \frac{\beta}{K+r_g} + \frac{\gamma}{K+r_f}
            \]
            \end{block}
            {\scriptsize $K=60$，输出 $\sim$400 token 的 \texttt{RankedEntity} 列表}
        \end{column}
    \end{columns}
\end{frame}

\begin{frame}{Prompt 组成：InterviewerAgent}
    \begin{columns}
        \begin{column}{0.48\textwidth}
            \begin{block}{System Prompt（静态）}
                \scriptsize
                \begin{itemize}
                    \item 角色定位：充满好奇心的传记访谈者
                    \item 访谈覆盖主题（Life Story Interview 规程）
                    \item 行为准则（5 条）：先回应后提问、好奇多于礼貌等
                    \item 内部 Planner 工作流（6 步）
                    \item 判停与结束判断
                    \item 输出要求（严格 JSON）
                    \item 工具调用说明
                \end{itemize}
            \end{block}
        \end{column}
        \begin{column}{0.48\textwidth}
            \begin{block}{User Prompt（每轮动态组装）}
                \scriptsize
                \begin{enumerate}
                    \item 受访者基本信息
                    \item 已了解的受访者特点（动态画像 + guidance）
                    \item 最近对话（3--5 轮）
                    \item 正在聊的经历（focus\_rich\_text）
                    \item 人生故事覆盖情况
                    \item 待探索的话题线索
                    \item 叙事记忆脉络（RRF 融合结果）
                    \item 策略提示（低信息警告 + 跨会话历史）
                    \item 任务指令 + JSON 格式要求
                \end{enumerate}
            \end{block}
        \end{column}
    \end{columns}
\end{frame}


