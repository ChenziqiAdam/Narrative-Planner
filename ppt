\begin{frame}{关键取舍：保留 vs.\ 放弃}
    \begin{columns}
        \begin{column}{0.5\textwidth}
            \begin{alertblock}{放弃的技术（及原因）}
                \scriptsize
                \begin{itemize}
                    \item \textbf{固定 8 槽位体系} — 太死板，强行填槽导致信息丢失
                    \item \textbf{CAMEL 框架} — 太重，控制力不够，手动实现更灵活
                    \item \textbf{NetworkX 内存图} — 不持久化，重启丢失，无法跨会话
                    \item \textbf{Planner/Interviewer 分离} — 两次 LLM 调用延迟高、上下文割裂
                    \item \textbf{独立决策策略文件} — 规则太多维护不动，交给 LLM 在 Prompt 内推理
                    \item \textbf{自适应路由校准} — 过度工程化，实际效果不明显
                    \item \textbf{本地 sentence-transformers} — 维度低(384)，中英文效果一般
                    \item \textbf{旧 RAG 模块} — 功能太简单，被 GraphRAG 三路融合取代
                \end{itemize}
            \end{alertblock}
        \end{column}
        \begin{column}{0.5\textwidth}
            \begin{block}{保留并持续优化}
                \scriptsize
                \begin{itemize}
                    \item McAdams \textbf{23 个人生主题}体系
                    \item \textbf{IntervieweeAgent} Tool Call 记忆系统
                    \item \textbf{DynamicProfile} 异步画像更新
                    \item \textbf{FAISS + RRF} 三路混合检索
                    \item \textbf{Planner Tool Call}（10 个只读工具）
                    \item \textbf{SessionGraphBridge} 跨会话记忆
                    \item \textbf{BatchInterview} 批量实验管线
                    \item \textbf{Cytoscape.js} 前端图谱可视化
                \end{itemize}
            \end{block}
        \end{column}
    \end{columns}
\end{frame}

\begin{frame}{核心洞见与关键设计决策}
    \begin{center}
        {\large\textbf{``从规则驱动的槽位填充，到数据驱动的图谱生长''}}
    \end{center}
    \vspace{0.2em}
    最大的架构决策是把 Planner 决策逻辑从硬编码规则（权重打分）转变为 LLM 内部推理 + 图谱证据驱动的 emergent behavior。
    \vspace{0.3em}
    \begin{block}{7 大关键设计决策}
        \small
        \begin{enumerate}
            \item \textbf{Schema-on-the-fly}：不预设固定槽位，LLM 自由提取实体和关系
            \item \textbf{Planner-NLG 统一}：输出结构化 planner\_plan + action + question，一次调用完成
            \item \textbf{RRF 三路融合}：向量 + 图 + 全文互补增强检索召回
            \item \textbf{实体去重}：向量余弦 $> 0.85$ + 名称子串双重校验
            \item \textbf{异步画像更新}：每 3--5 轮后台线程更新，不阻塞主流程
            \item \textbf{Tool Call 双向}：InterviewerAgent 有 Planner Tools，IntervieweeAgent 有 Memory Tools
            \item \textbf{跨会话连续性}：通过 elder\_id 关联，预加载历史图谱 + 向量索引
        \end{enumerate}
    \end{block}
\end{frame}


