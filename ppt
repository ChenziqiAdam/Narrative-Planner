\section{项目定位与核心痛点}
%% ============================================================

\begin{frame}{项目定位}
    \begin{center}
        {\Large\textbf{基于 GraphRAG 的智能叙事访谈系统}}
    \end{center}
    \vspace{0.3em}
    \textbf{核心目标：}辅助深度人生回忆录访谈。系统通过\textcolor{cuhksz1}{实时构建个人知识图谱} +
    \textcolor{cuhksz1}{语义检索} + \textcolor{cuhksz1}{动态画像}，驱动 LLM 生成有策略的访谈问题，
    确保访谈覆盖完整人生阶段并深挖高价值记忆。
    \vspace{0.5em}
    \textbf{直接 LLM 访谈的痛点}
    \begin{itemize}
        \item \textbf{遗忘主线} — 轮次间缺乏持久记忆
        \item \textbf{提问浅显} — 停留在表面，缺乏深度追问
        \item \textbf{逻辑跳跃} — 无覆盖追踪，遗漏人生阶段
        \item \textbf{重复提问} — 反复询问相同内容
    \end{itemize}
\end{frame}


