\section{我们做了什么}
%% ============================================================

\begin{frame}{系统全景图：5 层数据流水线}
    \begin{block}{每轮对话的完整生命周期}
        \footnotesize
        \begin{enumerate}
            \item \textbf{GraphExtractionAgent} — LLM 提取实体/关系（输入：当前轮 + 近 3 轮上下文 + 已有实体摘要）
            \item \textbf{GraphWriter} — 向量嵌入 $\to$ 去重（cos $> 0.85$）$\to$ Neo4j 写入 + FAISS 同步 $\to$ 事件-主题自动关联
            \item \textbf{HybridRetriever} — 三路混合检索（向量 $\alpha\!=\!0.5$ + 图遍历 $\beta\!=\!0.3$ + 全文 $\gamma\!=\!0.2$）$\to$ RRF 融合
            \item \textbf{GraphRAGDecisionContextBuilder} — 覆盖率 + 焦点叙事 + 图间隙 + 情绪 + 动态画像 $\to$ 决策上下文
            \item \textbf{InterviewerAgent} — Planner 6 步推理 + 问题生成，\textbf{单次 LLM 调用}
            \item \textbf{ProfileProjector} {\small （异步）}— 动态画像更新（每 3--5 轮）
        \end{enumerate}
    \end{block}
    \vspace{0.2em}
    \textbf{存储：}Neo4j（图数据库）+ FAISS（向量索引）\\    \textbf{模型：}Kimi 2.5（访谈员）+ moonshot-v1-8k（提取器）
\end{frame}

\begin{frame}{智能体体系}
    \begin{center}
    \begin{tabular}{lll}
