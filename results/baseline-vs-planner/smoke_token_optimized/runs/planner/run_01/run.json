  "turns": [
    {
      "turn_index": 1,
      "status": "completed",
      "elapsed_ms": 51654.61,
      "events": [
        {
          "role": "interviewee",
          "text": "哎哟，说起最早的记忆嘛，我们那会儿条件艰苦，我记得我小时候家里头条件不好，住在成都老城区的一个破旧小院里。那时候，我记得最清楚的就是我妈妈，她总是忙前忙后的，为了我们几个孩子操碎了心。我还记得，那时候院子里头有棵老槐树，夏天的时候，我们几个小孩儿就在树底下乘凉玩耍。那时候的日子虽然苦，但是邻里之间关系好得很，大家互相帮衬，那种温暖我现在还记得。",
          "extracted_events": [],
          "graph_delta": {},
          "memory_calls": [],
          "timing": {
            "interviewee_total_ms": 7632.3
          }
        },
        {
          "role": "interviewer",
