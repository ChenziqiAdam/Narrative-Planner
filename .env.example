# 查询优化功能配置示例

# ========================================
# 选项 1: 禁用查询优化（默认）
# ========================================
# 使用传统的直接 HybridRetriever 查询方式
# 优点：最小化修改，原始性能基准
# 缺点：查询逻辑在 orchestrator 中分散

# QUERY_OPTIMIZATION_ENABLED=false


# ========================================
# 选项 2: 启用查询优化
# ========================================
# 将查询委托给 GraphExtractionAgent
# 优点：统一的查询管理，便于扩展和调试
# 缺点：多一层间接调用

QUERY_OPTIMIZATION_ENABLED=true


# ========================================
# 相关配置选项参考
# ========================================

# 嵌入模型配置
EMBEDDING_PROVIDER=openai
EMBEDDING_OPENAI_API_KEY=your-zhipu-api-key
EMBEDDING_OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EMBEDDING_OPENAI_MODEL=embedding-3

# Neo4j 配置
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=narrative2026
NEO4J_DATABASE=neo4j

# LLM 配置
OPENAI_API_KEY=your-moonshot-api-key
OPENAI_BASE_URL=https://api.moonshot.cn/v1
MODEL_NAME=moonshot-v1-8k
CHAT_MODEL_NAME=moonshot-v1-8k
STRUCTURED_MODEL_NAME=moonshot-v1-8k

# Planner 工具配置
PLANNER_TOOLS_ENABLED=true
PLANNER_MAX_TOOL_ROUNDS=2
PLANNER_MAX_TOOLS_PER_ROUND=2

# 日志级别
LOG_LEVEL=INFO
